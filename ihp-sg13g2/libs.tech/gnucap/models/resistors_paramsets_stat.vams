  parameter real rsh_rsil = $rdist_normal(_rdist_seed, 0.0, 0.2) + global_res_typ.rsh_rsil_eff;
  //parameter real rsh_rsil = 7.0;

    .c1 = 1;
    .a2 = a;
    .tc2 = 0.3e-6;
    .a1 = a;
    .trise = trise;
    .dfinf = 1e-4;
    .gthp = 2e-6;
    .cp = cpx;
    .gth0 = 1e-12;
    .cth0 = 0;
    .nsmm_rsh = 1;
    .bfn = 1.267;
    .gtha = 6e-6;
    .sw_mman = 1;
    .ca = cax;
    .gthc = 1e-12;
    .nsmm_w = 1;
    .ctha = 594e-15;
    .sw_et = sw_et;
    .rc = rz;
    .xw = 0.01;
    .ecrit = 1000;
    .afn = 1.607;
    .tc1 = 3100e-6;
    .w = weff;
    .c2 = 1;
    .rsh =  rsh_rsil;
    .l = leff;
    .kfn = 2.812e-12;
    .cthp = 0;
    .smm_rsh = 1.2;
    .cthc = 0;
    .nsmm_l = 1;
    .smm_w = 0.01;
    .tc2rc = 0.3e-6;
    .dp = 1000;
    .tc1rc = 3100e-6;
    .p2 = p;
    .p1 = p;
    .smm_l = 0.01;
     
endparamset 
