.smm_l     = 0.01;
.smm_rsh   = 1.2;
.nsmm_w    = 1;
.nsmm_l    = 1;
.nsmm_rsh  = 1;
.tc1     = 3100e-6;
.tc2     = 0.3e-6;
.tc1rc   = 3100e-6;
.tc2rc   = 0.3e-6;
.dfinf   = 1e-4;
.dp      = 1000;
.ecrit   = 1000;
      
endparamset

