`pragma modelgen nogen-module
`pragma modelgen gen-paramset
`include "capacitor.va"
`include "resistor.va"
`include "inductor.va"

paramset cap_cmim cmim
 
  parameter integer _rdist_seed = 0;

  parameter real l = 7e-6;
  parameter real w = 7e-6;
  parameter real sf = 1E-6;
  parameter real ic = 1E10;
  parameter real r = 55e-3;
  parameter real tc1 = 3.6E-6;
  parameter real tc2 = 2E-9;
  parameter real cj = 1.0e-12;
  parameter real cjsw = 40E-18;

  .l = l;
  .w = w;
  .sf = sf;
  .ic = ic;
  .r = r;
  .tc1 = tc1;
  .tc2 = tc2;
  .cj = cj;
  .cjsw = cjsw;
endparamset

paramset cparasitic sp_capacitor

  parameter integer _rdist_seed = 0;
  parameter real c = 0;
  parameter real tc1 = 0;
  parameter real tc2 = 0;

  .capacitance = c * `cap_cpara;
  .tc1 = tc1;
  .tc2 = tc2;
endparamset

