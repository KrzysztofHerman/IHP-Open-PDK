// Verilog
// Libraries
load mgsim
verilog
// options trace
//load ../plugins/cornerRES_typ.so
//load ../plugins/cornerRES_wcs.so
//load ../plugins/cornerRES_bcs.so
load ../plugins/cornerRES_stat.so

`include "../models/resistors_stat.vams"


ground gnd;
parameter seed = 0;


module res_sp(n1, n2, n3, gnd);
  parameter integer seed=0;
  parameter integer mm_ok=0;
  electrical net1, net2, net3;
  ptap1  #(.R(150)) rp1(n1, net1);
  ptap1  #(.R(150)) rp2(net1, gnd);
  ntap1  #(.R(220)) rn1(n2, net2);
  ntap1  #(.R(220)) rn2(net2, gnd);
  Rparasitic #() rpara1(n3, net3);
  Rparasitic #() rpara2(net3, gnd);
  res_typ #(.xyz($rdist_normal(seed,0.0,0.2))) global_res_typ();
endmodule

module res_tb(n1, n2, n3, gnd);
  parameter integer seed=0;
  parameter integer mm_ok=0;
  electrical net1, net2, net3;
  rsil  #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r1(n1, gnd, net1);
  rsil  #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r2(net1, gnd, gnd);
  rppd  #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r3(n2, gnd, net2);
  rppd  #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r4(net2, gnd, gnd);
  rhigh #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r5(n3, gnd, net3);
  rhigh #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r6(net3, gnd, gnd);
  res_typ #(.xyz($rdist_normal(seed,0.0,0.2))) global_res_typ();
endmodule

res_sp #(.seed(seed), .mm_ok(1)) tb1(n1, n2, n3, gnd);
res_tb #(.seed(seed), .mm_ok(1)) tb2(n4, n5, n6, gnd);
//                            ^ 1 also works.

spice
.options noinsensitive
Ir1 n1 gnd 1m
Ir2 n2 gnd 1m
Ir3 n3 gnd 1m
Ir4 n4 gnd 1m
Ir5 n5 gnd 1m
Ir6 n6 gnd 1m
.print dc    v(tb1.r*) v(tb2.r*) 
.dc seed 0 10 1 

