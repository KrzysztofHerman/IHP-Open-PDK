// Verilog
// Libraries
load mgsim
verilog
options debug
load ../plugins/resistors_paramsets.so

module res_typ();
  // ---- seeds (constants) ----
  parameter real SEED = 101;
  
  parameter real xyz = 0.0;

  // ---- nominal (per corner) ----
  parameter real rsh_rsil_nom = 7.0;     // ohm/sq (example)

  // ---- 1-sigma variations (example numbers) ----
  parameter real rsh_rsil_sigma_l = 0.20; // ohm/sq local

  // ---- local (instance mismatch) ----
  parameter real drsh_l = xyz;

  // ---- final effective params for this corner ----
  parameter real rsh_rsil_eff = rsh_rsil_nom  + drsh_l;
endmodule


ground gnd;
parameter seed = 0;

  res_typ #(.xyz($rdist_normal(seed,0.0,0.2))) global_res_typ();

module rsil_tb(n1, n2, gnd);
  parameter integer seed=0;
  parameter integer mm_ok=0;
  rsil #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r2(n2, gnd, n1);
  rsil #(.l(0.5u), .w(0.5u), ._rdist_seed(seed), .mm_ok(mm_ok)) r1(n1, gnd, gnd);
endmodule

rsil_tb #(.seed(seed), .mm_ok(1)) tb(n1, n2, gnd);

spice
.options noinsensitive
Ir n2 gnd 1
.print dc    v(tb.r*)
.dc seed 0 10 1 
