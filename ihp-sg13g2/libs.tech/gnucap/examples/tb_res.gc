// Verilog
// Libraries
load mgsim
verilog
load ../plugins/resistors_paramsets.so
load vams/vpulse.so

module res_typ();
  // ---- seeds (constants) ----
  parameter real SEED = 101;

  // ---- nominal (per corner) ----
  parameter real rsh_rsil_nom = 7.0;     // ohm/sq (example)

  // ---- 1-sigma variations (example numbers) ----
  parameter real rsh_rsil_sigma_l = 0.20; // ohm/sq local

  // ---- local (instance mismatch) ----
  parameter real drsh_l = $rdist_normal(0, 0.0, rsh_rsil_sigma_l);

  // ---- final effective params for this corner ----
  parameter real rsh_rsil_eff = rsh_rsil_nom  + drsh_l;
endmodule


ground gnd;
res_typ #() global_res_typ();

rsil #(.l(0.5u), .w(0.5u)) r1(n1, gnd, gnd);

spice
Ir n1 gnd 1
.print dc  v(r1)
.options seed=2
.dc
.options seed=3
.dc


