// Verilog
// Libraries
load mgsim
verilog
load ../plugins/cornerRES_typ.so
load vams/vpulse.so


ground gnd;

rsil #(.l(0.5u), .w(0.5u) ) r0(n1, gnd, gnd);
rsil #(.l(0.5u), .w(0.5u), .mm_ok(1) ) r1(n1, gnd, gnd);
rppd #(.l(0.5u), .w(0.5u) ) r2(n2, gnd, gnd);
rhigh #(.l(0.96u), .w(0.5u) ) r3(n3, gnd, gnd);
rhigh #(.l(0.96u), .w(0.5u), .mm_ok(0) ) r4(n4, gnd, gnd);
rhigh #(.l(0.96u), .w(0.5u), .mm_ok(1) ) r5(n5, gnd, gnd);

spice
Ir1 n0 gnd 0.001
Ir2 n1 gnd 0.001
Ir3 n2 gnd 0.001
Ir4 n3 gnd 0.001
Ir5 n4 gnd 0.001
Ir6 n5 gnd 0.001
.print dc  v(r1) v(r2) v(r3) v(r4) v(r5) v(r0)
.dc
.options seed=25
.dc

